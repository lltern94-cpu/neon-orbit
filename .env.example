# Токен от @BotFather. Не публикуй его и не коммить файл .env
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME_WITH_YOUR_BOT_TOKEN

# Максимальный размер загружаемого файла в мегабайтах
MAX_FILE_SIZE_MB=15

# Лимит пикселей на выходе (ширина * высота). Защита от нехватки памяти.
MAX_OUTPUT_PIXELS=16000000

# Максимальная сторона входного изображения перед апскейлом
MAX_INPUT_SIDE=4096

# Папка для временных файлов
TEMP_DIR=tmp

# Папка с весами Real-ESRGAN (например RealESRGAN_x4plus.pth)
MODELS_DIR=models

# Полный путь к файлу модели, если он лежит не в models/
# REALESRGAN_MODEL_PATH=C:\path\to\RealESRGAN_x4plus.pth

# Масштаб по умолчанию для новых пользователей: 2 или 4
DEFAULT_SCALE=2

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
